# KSP Sentinel AI — Standalone Environment Configuration Template
# Copy this file to .env.standalone and populate with your own credentials

# ── Primary LLM: Groq (14,400 req/day free) ──────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Fallback LLM: Google Gemini Flash (1M tokens/day free) ────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server Port ───────────────────────────────────────────────────────────────
PORT=5000

# ── Zoho Catalyst Zia Speech & QuickML Configuration ──────────────────────────
client_id=your_zoho_client_id_here
client_secret=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ACCESS_TOKEN=your_zoho_access_token_here
ZOHO_API_DOMAIN=https://www.zohoapis.in
CATALYST_PROJECT_ID=your_catalyst_project_id_here
CATALYST_ORG_ID=your_catalyst_org_id_here
ZIA_AUDIO_ENDPOINT=https://api.catalyst.zoho.in/quickml/api/v1/models/zia/audio/transcribe

# ── Application Endpoints ────────────────────────────────────────────────────
Home_page_url=http://localhost:5000
authorized_redirects_url=http://localhost:5000/callback
client_name=KSPCrimeIntelligencePlatform
